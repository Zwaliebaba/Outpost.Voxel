# Outpost.Voxel — C++ layout (AGENTS.md §4).
#
# Conformance authority: AGENTS.md. clang-format owns WHITESPACE; /.clang-tidy owns NAMING and
# semantics. The two never overlap: clang-tidy has no check that reports a wrong brace position
# or an over-long line, and clang-format cannot see that a parameter is missing its `_`. Asking
# either to do the other's job is how a repository ends up with neither.
#
# This tree is formatted from its first line: format everything you write, and a whole-tree run
# should be a no-op rather than an unreviewable rewrite.
#
# ── Status: CI gates on this, over the whole tree ──────────────────────────────────────────
#
# `Build/CheckFormat.py` runs in its own Linux job and fails the build on an unformatted file
# (AGENTS.md §6), on clang-format 18.1.3 exactly -- the output changes between releases, so if a
# local run disagrees with CI, compare the version line first. Run it yourself before you push.
#
# `python Build/CheckFormat.py --fix` rewrites the offenders, and `--clang-format <binary>` names
# the binary when the pinned one is not first on PATH. It checks .cpp and .h; whether HLSL is
# formatted by this file too is decided when the first shader lands (Design/SampleRenderer.md).
#
# On Windows the clang-format you have is almost certainly NOT 18: Visual Studio 2026 bundles 22
# at VC\Tools\Llvm\x64\bin, and 22 breaks a long call argument list in a different place than 18
# does. CheckFormat.py prints the version it used and says so when it is not the pinned one; the
# Linux job is the answer that counts.
# Keep ColumnLimit and IndentWidth in step with /.editorconfig; if you change one, change the other
# in the same commit or they start lying to each other.
#
# ── Deliberate choices ─────────────────────────────────────────────────────────────────────
#
# LineEnding is left at its default (DeriveLF) ON PURPOSE. Working trees are CRLF on Windows and
# LF in Linux containers, so deriving per file means the same command is a no-op in both places.
#
# AlignConsecutive{Assignments,Declarations} are OFF: clang-format cannot express "align this
# short run but not that one", and switching them on aligns unrelated statements across whole
# blocks.
#
# ReflowComments is OFF so that the block comments explaining a decision keep the line breaks
# their author chose.

Language: Cpp
BasedOnStyle: LLVM
Standard: Latest

ColumnLimit: 140
IndentWidth: 2
TabWidth: 2
UseTab: Never
ContinuationIndentWidth: 2

# Allman: every brace on its own line.
BreakBeforeBraces: Allman

# A namespace does not indent its contents — the whole file would be one level in for no
# information gained.
NamespaceIndentation: None

# -2, matching IndentWidth: `public:` sits flush with the `class`, its members one step in.
AccessModifierOffset: -2
IndentAccessModifiers: false
IndentCaseLabels: false

IndentPPDirectives: AfterHash
PPIndentWidth: 3

# Widget* _widget, not Widget *_widget.
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false

# Control flow never folds onto one line; an empty body may.
AllowShortFunctionsOnASingleLine: Empty
AllowShortBlocksOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortLambdasOnASingleLine: All

BreakConstructorInitializers: BeforeColon
ConstructorInitializerIndentWidth: 2
PackConstructorInitializers: Never

# A `requires` clause goes on its own line, indented under the template head — the constraint is
# part of the declaration's contract and reads as such.
SpaceBeforeParens: Custom
SpaceBeforeParensOptions:
  AfterControlStatements: true
  AfterRequiresInClause: true
  AfterRequiresInExpression: false
RequiresClausePosition: OwnLine
IndentRequiresClause: true

AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignAfterOpenBracket: Align
AlignEscapedNewlines: Left
AlignTrailingComments: true

# Include order is load-bearing and grouped by hand (AGENTS.md §4): pch.h, then windows.h before
# any other Windows SDK header (with WIN32_LEAN_AND_MEAN and NOMINMAX already defined), then the
# rest of the SDK, then project headers, then the standard library. A formatter reordering these
# behind a change's back is a correctness risk, not a style preference.
SortIncludes: Never
IncludeBlocks: Preserve

BinPackArguments: true
BinPackParameters: true
Cpp11BracedListStyle: true
FixNamespaceComments: true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
SpacesBeforeTrailingComments: 1
ReflowComments: false

# The Visual Studio unit-test macros read as calls, so clang-format collapses a whole TEST_CLASS
# into one line of nonsense. Describing what they expand to lets it format a test file like the
# class and methods it actually is.
Macros:
  - 'TEST_CLASS(x)=class x'
  - 'TEST_METHOD(x)=void x()'
  - 'TEST_CLASS_INITIALIZE(x)=void x()'
  - 'TEST_CLASS_CLEANUP(x)=void x()'
  - 'TEST_METHOD_INITIALIZE(x)=void x()'
  - 'TEST_METHOD_CLEANUP(x)=void x()'
