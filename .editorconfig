# Baseline whitespace, so an editor gets it right before clang-format runs.
#
# /.clang-format is the AUTHORITY for C++ layout (AGENTS.md §4). This file exists for the formats
# clang-format does not cover — HLSL, Python, shell, YAML, MSBuild XML, JSON content — and, for
# C++, repeats only the two numbers an editor needs before the first save. Where the two disagree,
# clang-format wins; keep IndentWidth and ColumnLimit in step with it.

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Mirrors /.clang-format's IndentWidth and ColumnLimit.
[*.{cpp,h}]
indent_size = 2
max_line_length = 140

# Shaders are hand-written source and read best at the same width as the C++ that drives them.
[*.{hlsl,hlsli}]
indent_size = 2
max_line_length = 140

[*.{vcxproj,filters,slnx,props,targets}]
indent_size = 2

# The Visual Studio resource editor writes .rc and .rc2 as UTF-16 and rewrites them wholesale.
# Declaring utf-8 here would make every editor that honours this file corrupt them on save.
[*.{rc,rc2}]
charset = utf-16le
trim_trailing_whitespace = false
insert_final_newline = false

# Config and content authored by hand.
[*.json]
indent_size = 2

# LF for the formats read by non-Windows tooling — the format checker runs in a Linux container.
[*.{yml,yaml}]
end_of_line = lf
indent_size = 2

[*.py]
end_of_line = lf
indent_size = 2
max_line_length = 120

[*.sh]
end_of_line = lf
indent_size = 2

[*.md]
end_of_line = lf
trim_trailing_whitespace = false
